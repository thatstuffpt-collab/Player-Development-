generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  TRAINER
  GUARDIAN
  ADMIN
}

enum GoalType {
  BIG_PICTURE
  DEVELOPMENT
}

enum GoalStatus {
  ACTIVE
  COMPLETED
  PAUSED
  ARCHIVED
}

enum AchievementType {
  TEAM_SELECTION
  AWARD
  OFFER
  PERSONAL_MILESTONE
  RATING_IMPROVEMENT
  TRAINING_MILESTONE
  CAMP_RECOGNITION
  OTHER
}

enum WorkStatus {
  ASSIGNED
  IN_PROGRESS
  COMPLETED
  ARCHIVED
}

enum SessionFocusArea {
  BALL_HANDLING
  FINISHING
  SHOOTING
  DEFENSE
  FOOTWORK
  DECISION_MAKING
  CONDITIONING
  OTHER
}

enum PracticePlanItemType {
  SECTION
  DRILL
}

enum ProgressEventType {
  SHOOTING_RESULT
  DRIBBLING_RESULT
  DRILL_PROGRESSION
  GOAL_CHECK
  COACH_OBSERVATION
  BODY_READINESS
  OTHER
}

enum ProgressNextStep {
  GOAL_MET
  KEEP_PROGRESSING
  REVISIT_NEXT_SESSION
  CHANGE_FOCUS
}

model Tenant {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  users     User[]
  players   Player[]
}

model User {
  id              String           @id @default(cuid())
  tenantId        String
  firebaseUid     String?          @unique
  email           String           @unique
  displayName     String?
  role            UserRole
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  tenant          Tenant           @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  guardianPlayers GuardianPlayer[]

  @@index([tenantId, role])
}

model Player {
  id                  String             @id @default(cuid())
  tenantId            String
  firstName           String
  lastName            String
  preferredName       String?
  birthDate           DateTime?
  classYear           Int?
  height              String?
  position            String?
  schoolTeam          String?
  yearsPlaying        Int?
  playingExperience   String?
  selfReportedNeeds   String?
  trainingLimitations String?
  archivedAt          DateTime?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  tenant              Tenant             @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  guardians           GuardianPlayer[]
  goals               Goal[]
  evaluations         Evaluation[]
  progressEvents      ProgressEvent[]
  achievements        Achievement[]
  assignedWork        AssignedWork[]
  trainerNotes        TrainerNote[]
  developmentFocuses  DevelopmentFocus[]
  trainingSessions    TrainingSession[]
  coachTags           PlayerCoachTag[]
  athleticTests       AthleticTest[]

  @@index([tenantId, archivedAt])
}

model GuardianPlayer {
  id         String   @id @default(cuid())
  guardianId String
  playerId   String
  createdAt  DateTime @default(now())
  guardian   User     @relation(fields: [guardianId], references: [id], onDelete: Cascade)
  player     Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([guardianId, playerId])
  @@index([playerId])
}

model Goal {
  id          String     @id @default(cuid())
  playerId    String
  type        GoalType
  title       String
  description String?
  status      GoalStatus @default(ACTIVE)
  targetDate  DateTime?
  completedAt DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  player      Player     @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@index([playerId, status])
}

model EvaluationTemplate {
  id          String                @id @default(cuid())
  name        String
  description String?
  version     Int
  isActive    Boolean               @default(true)
  createdAt   DateTime              @default(now())
  criteria    EvaluationCriterion[]
  evaluations Evaluation[]

  @@unique([name, version])
}

model EvaluationCriterion {
  id          String              @id @default(cuid())
  templateId  String
  key         String
  label       String
  description String?
  sortOrder   Int
  template    EvaluationTemplate  @relation(fields: [templateId], references: [id], onDelete: Cascade)
  ratings     EvaluationRating[]

  @@unique([templateId, key])
  @@unique([templateId, sortOrder])
}

model Evaluation {
  id             String             @id @default(cuid())
  playerId       String
  templateId     String
  evaluatedAt    DateTime           @default(now())
  summary        String?
  nextFocus      String?
  priorityAreas  String[]           @default([])
  shortTermGoal  String?
  createdAt      DateTime           @default(now())
  player         Player             @relation(fields: [playerId], references: [id], onDelete: Cascade)
  template       EvaluationTemplate @relation(fields: [templateId], references: [id])
  ratings        EvaluationRating[]

  @@index([playerId, evaluatedAt])
}

model EvaluationRating {
  id              String              @id @default(cuid())
  evaluationId    String
  criterionId     String
  rating          Int?
  observationTags String[]            @default([])
  note            String?
  evidence        String?
  evaluation      Evaluation          @relation(fields: [evaluationId], references: [id], onDelete: Cascade)
  criterion       EvaluationCriterion @relation(fields: [criterionId], references: [id])

  @@unique([evaluationId, criterionId])
  @@index([criterionId])
}

model ProgressEvent {
  id                 String            @id @default(cuid())
  playerId           String
  sessionId          String?
  practicePlanItemId String?
  occurredAt         DateTime          @default(now())
  type               ProgressEventType @default(OTHER)
  category           String
  title              String
  result             String
  spot               String?
  context            String?
  notes              String?
  nextStep           ProgressNextStep?
  nextTime           String?
  parentVisible      Boolean           @default(false)
  createdAt          DateTime          @default(now())
  player             Player            @relation(fields: [playerId], references: [id], onDelete: Cascade)
  session            TrainingSession?  @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  practicePlanItem   PracticePlanItem? @relation(fields: [practicePlanItemId], references: [id], onDelete: SetNull)

  @@index([playerId, occurredAt])
  @@index([sessionId])
  @@index([practicePlanItemId])
}

model DevelopmentFocus {
  id          String   @id @default(cuid())
  playerId    String
  focus       String
  reason      String?
  startedAt   DateTime @default(now())
  completedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  player      Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@index([playerId, completedAt])
}

model Achievement {
  id          String          @id @default(cuid())
  playerId    String
  type        AchievementType @default(OTHER)
  title       String
  description String?
  achievedAt  DateTime        @default(now())
  createdAt   DateTime        @default(now())
  player      Player          @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@index([playerId, achievedAt])
}

model AssignedWork {
  id          String     @id @default(cuid())
  playerId    String
  title       String
  description String?
  status      WorkStatus @default(ASSIGNED)
  assignedAt  DateTime   @default(now())
  dueAt       DateTime?
  completedAt DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  player      Player     @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@index([playerId, status])
}

model TrainerNote {
  id        String   @id @default(cuid())
  playerId  String
  body      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  player    Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@index([playerId, createdAt])
}

model PlayerCoachTag {
  id        String   @id @default(cuid())
  playerId  String
  label     String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  player    Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([playerId, label])
  @@index([playerId, isActive])
}

model TrainingSession {
  id                   String             @id @default(cuid())
  playerId             String
  scheduledFor         DateTime
  primaryFocus         SessionFocusArea
  customFocus          String?
  sessionGoal          String?
  sorenessLevel        String?
  bodyArea             String?
  discomfortLevel      Int?
  planAdjustmentReason String?
  summary              String?
  needsMoreWork        String?
  nextSessionFocus     String?
  completedAt          DateTime?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  player               Player             @relation(fields: [playerId], references: [id], onDelete: Cascade)
  practicePlan         PracticePlanItem[]
  progressEvents       ProgressEvent[]

  @@index([playerId, scheduledFor])
}

model PracticePlanItem {
  id             String               @id @default(cuid())
  sessionId      String
  parentItemId   String?
  itemType       PracticePlanItemType  @default(DRILL)
  focusArea      SessionFocusArea?
  sortOrder      Int
  title          String
  notes          String?
  completed      Boolean              @default(false)
  session        TrainingSession      @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  parentItem     PracticePlanItem?     @relation("PracticePlanHierarchy", fields: [parentItemId], references: [id], onDelete: Cascade)
  childItems     PracticePlanItem[]    @relation("PracticePlanHierarchy")
  progressEvents ProgressEvent[]

  @@index([sessionId, sortOrder])
  @@index([parentItemId])
}

model AthleticTest {
  id            String   @id @default(cuid())
  playerId      String
  category      String
  testKey       String
  testName      String
  value         Float
  unit          String
  lowerIsBetter Boolean  @default(false)
  notes         String?
  testedAt      DateTime @default(now())
  createdAt     DateTime @default(now())
  player        Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@index([playerId, testedAt])
  @@index([playerId, testKey])
}
