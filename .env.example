# Local development only. Never commit a real password.
# Example:
# DATABASE_URL="postgresql://player_app:password@127.0.0.1:5432/player_development?schema=public"
DATABASE_URL=

# Cloud Run constructs DATABASE_URL from these values when DATABASE_URL is absent.
DB_NAME=player_development
DB_USER=player_app
DB_PASSWORD=
CLOUD_SQL_INSTANCE=thats-tuff-player-development:us-central1:player-development-db
